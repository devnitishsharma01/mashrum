# Database
DATABASE_URL=postgresql://mashrum:mashrum@localhost:5432/mashrum?schema=public

# Redis / queue
REDIS_URL=redis://localhost:6379
# auto = Redis if available, else in-process memory
QUEUE_DRIVER=auto

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NODE_ENV=development

# Auth (change in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Encryption for WhatsApp tokens at rest (32-byte hex = 64 chars)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta WhatsApp Cloud API (fill when connecting)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Optional platform-wide webhook verify token (in addition to per-business tokens)
META_WEBHOOK_VERIFY_TOKEN=
# When true, outbound WA messages are logged locally instead of calling Meta
WHATSAPP_MOCK_SEND=true

# Uploads (local disk for MVP; set STORAGE_DRIVER=s3 for object storage)
# Prefer an absolute path so API cwd does not matter
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for MinIO / R2 / custom endpoints
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=
S3_OBJECT_ACL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
