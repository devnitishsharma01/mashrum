generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DELIVERY_FAILED
  RETURNED
  CUSTOMER_NOT_REACHABLE
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  CANCELLED
}

enum ActorType {
  USER
  SYSTEM
  CUSTOMER
}

enum InventoryMovementReason {
  ORDER_CONFIRM
  ORDER_CANCEL_RESTORE
  ORDER_RETURN_RESTORE
  ADJUSTMENT
  MANUAL_SET
}

model Business {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  timezone      String         @default("Asia/Kolkata")
  currency      String         @default("INR")
  phone         String?
  address       String?
  status        BusinessStatus @default(ACTIVE)
  codEnabled    Boolean        @default(true) @map("cod_enabled")
  workingHours  Json           @map("working_hours")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  users              User[]
  whatsappAccount    WhatsAppAccount?
  categories         Category[]
  products           Product[]
  productVariants    ProductVariant[]
  customers          Customer[]
  customerAddresses  CustomerAddress[]
  carts              Cart[]
  orders             Order[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  payments           Payment[]
  messageTemplates   MessageTemplate[]
  automationRules    AutomationRule[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  whatsappMessages      WhatsAppMessage[]
  refreshTokens         RefreshToken[]
  conversationSessions  ConversationSession[]

  @@map("businesses")
}

model User {
  id           String   @id @default(cuid())
  businessId   String   @map("business_id")
  email        String
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(OWNER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  businessId String   @map("business_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([businessId])
  @@map("refresh_tokens")
}

model WhatsAppAccount {
  id                   String                 @id @default(cuid())
  businessId           String                 @unique @map("business_id")
  wabaId               String?                @map("waba_id")
  phoneNumberId        String                 @unique @map("phone_number_id")
  displayPhone         String?                @map("display_phone")
  accessTokenEncrypted String                 @map("access_token_encrypted")
  webhookVerifyTokenHash String               @map("webhook_verify_token_hash")
  status               WhatsAppAccountStatus  @default(DISCONNECTED)
  lastError            String?                @map("last_error")
  connectedAt          DateTime?              @map("connected_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

model WhatsAppWebhookEvent {
  id              String             @id @default(cuid())
  providerEventId String             @unique @map("provider_event_id")
  phoneNumberId   String?            @map("phone_number_id")
  businessId      String?            @map("business_id")
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  error           String?
  processedAt     DateTime?          @map("processed_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([phoneNumberId])
  @@index([businessId])
  @@map("whatsapp_webhook_events")
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  businessId  String           @map("business_id")
  customerId  String?          @map("customer_id")
  direction   MessageDirection
  waMessageId String?          @unique @map("wa_message_id")
  type        String
  body        String?
  status      MessageStatus    @default(QUEUED)
  error       String?
  rawPayload  Json?            @map("raw_payload")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, customerId, createdAt])
  @@map("whatsapp_messages")
}

model Category {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  slug       String
  sortOrder  Int      @default(0) @map("sort_order")
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, slug])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  categoryId  String?  @map("category_id")
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  isVisible   Boolean  @default(true) @map("is_visible")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants  ProductVariant[]
  cartItems CartItem[]
  orderItems OrderItem[]
  inventory Inventory[]

  @@index([businessId, categoryId])
  @@index([businessId, isVisible])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  productId   String   @map("product_id")
  name        String
  sku         String?
  price       Decimal  @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  inventory  Inventory[]

  @@index([businessId, productId])
  @@index([businessId, sku])
  @@map("product_variants")
}

model Customer {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  waId          String   @map("wa_id")
  name          String?
  notes         String?
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addresses            CustomerAddress[]
  carts                Cart[]
  orders               Order[]
  messages             WhatsAppMessage[]
  conversationSessions ConversationSession[]

  @@unique([businessId, waId])
  @@index([businessId])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  customerId String   @map("customer_id")
  line1      String
  landmark   String?
  city       String?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([businessId])
  @@map("customer_addresses")
}

model Cart {
  id         String     @id @default(cuid())
  businessId String     @map("business_id")
  customerId String     @map("customer_id")
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([businessId, customerId, status])
  @@map("carts")
}

model ConversationSession {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  customerId String   @map("customer_id")
  state      String   @default("IDLE")
  context    Json     @default("{}")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, customerId])
  @@index([businessId])
  @@map("conversation_sessions")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  qty       Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Order {
  id                      String        @id @default(cuid())
  businessId              String        @map("business_id")
  customerId              String        @map("customer_id")
  orderNumber             String        @map("order_number")
  status                  OrderStatus   @default(NEW)
  paymentMethod           PaymentMethod @default(COD) @map("payment_method")
  paymentStatus           PaymentStatus @default(PENDING) @map("payment_status")
  subtotal                Decimal       @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  deliveryAddressSnapshot Json?         @map("delivery_address_snapshot")
  notes                   String?
  stockReserved           Boolean       @default(false) @map("stock_reserved")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  timeline OrderTimeline[]
  payment  Payment?

  @@unique([businessId, orderNumber])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  productId    String? @map("product_id")
  variantId    String? @map("variant_id")
  nameSnapshot String  @map("name_snapshot")
  qty          Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderTimeline {
  id         String      @id @default(cuid())
  orderId    String      @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id")
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_timelines")
}

model Inventory {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  productId      String   @map("product_id")
  variantId      String?  @map("variant_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([businessId, productId, variantId])
  @@index([businessId])
  @@map("inventory")
}

model InventoryMovement {
  id          String                  @id @default(cuid())
  businessId  String                  @map("business_id")
  inventoryId String                  @map("inventory_id")
  delta       Int
  reason      InventoryMovementReason
  refType     String?                 @map("ref_type")
  refId       String?                 @map("ref_id")
  note        String?
  createdAt   DateTime                @default(now()) @map("created_at")

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([inventoryId])
  @@map("inventory_movements")
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String        @map("business_id")
  orderId     String        @unique @map("order_id")
  method      PaymentMethod @default(COD)
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  collectedAt DateTime?     @map("collected_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("payments")
}

model MessageTemplate {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  key        String
  name       String?
  body       String
  metaTemplateName String? @map("meta_template_name")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@map("message_templates")
}

model AutomationRule {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  event       String
  templateKey String   @map("template_key")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, event])
  @@map("automation_rules")
}

model Notification {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  userId     String    @map("user_id")
  type       String
  title      String
  body       String?
  payload    Json?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([businessId])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("audit_logs")
}
