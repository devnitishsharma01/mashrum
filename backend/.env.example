# Database (local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/mushroom

# Redis / queue (optional; falls back to memory)
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=auto

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NODE_ENV=development

# Auth (change in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Encryption for WhatsApp tokens at rest (32-byte hex = 64 chars)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta WhatsApp Cloud API (fill when connecting)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_MOCK_SEND=true

# Uploads — local or S3 (STORAGE_DRIVER=local|s3)
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
STORAGE_DRIVER=local

# AWS S3 (used when STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional overrides
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=
S3_OBJECT_ACL=
